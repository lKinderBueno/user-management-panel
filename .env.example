# ==============================================================================
# PlaylistLabs User Management - Environment Configuration (Optional)
# ==============================================================================
# NOTE: 
# 1. Database passwords and JWT secret are managed securely via Docker Secrets 
#    in the `secrets/` directory (secrets/db_password.txt, secrets/jwt_secret.txt).
# 2. Master Admin account, PlaylistLabs Access Token & URL, Sync Intervals,
#    Caching, and Anti-Brute-Force security are configured directly in
#    your browser via the Initial Setup Wizard upon first launch (http://localhost:8080).
# ==============================================================================

# --- Application Version / Tag (Default: latest, or pin to 1.0, 1.1, etc.) ---
APP_VERSION=latest

# --- Logging Level (debug, info, warn, error) ---
LOG_LEVEL=info

# --- Public Ingress Gateway Ports & Domain (Caddy) ---
# Only Caddy is exposed publicly. All databases, caches, and internal microservices
# are isolated inside Docker's internal private network for maximum security.
HTTP_PORT=80
HTTPS_PORT=443
DOMAIN=localhost

# --- Database Host & Port (if running external database) ---
# MARIADB_HOST=mariadb
# MARIADB_PORT=3306
# MARIADB_DATABASE=playlistlabs
# MARIADB_USER=playlistlabs
