# Stage 1: Build Frontend SPA using native builder platform
FROM --platform=$BUILDPLATFORM node:22-alpine AS web-builder
ARG APP_VERSION=1.0.6
ENV VITE_APP_VERSION=${APP_VERSION}
WORKDIR /app/web
COPY web/package*.json ./
RUN npm ci || npm install
COPY web/ ./
RUN npm run build

# Stage 2: Build Go Dashboard Server using native Go cross-compilation
FROM --platform=$BUILDPLATFORM golang:alpine AS go-builder
ARG TARGETARCH
ARG USE_GARBLE=false
ARG APP_VERSION=1.0.6
WORKDIR /app
RUN if [ "$USE_GARBLE" = "true" ]; then \
        apk add --no-cache git && \
        go install mvdan.cc/garble@latest; \
    fi
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN if [ -n "$TARGETARCH" ]; then export GOARCH="$TARGETARCH"; fi; \
    if [ "$USE_GARBLE" = "true" ]; then \
        CGO_ENABLED=0 GOOS=linux garble -literals -tiny build -ldflags="-s -w -X 'playlistlabs_user_management_os/internal/version.Version=${APP_VERSION}'" -trimpath -o /app/dashboard ./cmd/dashboard && \
        CGO_ENABLED=0 GOOS=linux garble -literals -tiny build -ldflags="-s -w -X 'playlistlabs_user_management_os/internal/version.Version=${APP_VERSION}'" -trimpath -o /usr/local/bin/reset_password ./cmd/reset_password; \
    else \
        CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w -X 'playlistlabs_user_management_os/internal/version.Version=${APP_VERSION}'" -o /app/dashboard ./cmd/dashboard && \
        CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w -X 'playlistlabs_user_management_os/internal/version.Version=${APP_VERSION}'" -o /usr/local/bin/reset_password ./cmd/reset_password; \
    fi

# Stage 3: Final Production Image
FROM alpine:3.20
RUN apk --no-cache add ca-certificates tzdata

RUN adduser -D -u 1000 appuser

WORKDIR /app

COPY --from=go-builder /app/dashboard /app/dashboard
COPY --from=go-builder /usr/local/bin/reset_password /usr/local/bin/reset_password
COPY --from=go-builder /usr/local/bin/reset_password /app/reset_password
COPY --from=web-builder /app/web/dist /app/web/dist

RUN mkdir -p /data/epg /app/backups && \
    chown -R appuser:appuser /app /data/epg

USER appuser

ARG APP_VERSION=1.0.6
ENV APP_VERSION=${APP_VERSION}
ENV DASHBOARD_PORT=8080
ENV PORT=8080
ENV STATIC_DIR=/app/web/dist

EXPOSE 8080
CMD ["/app/dashboard"]
